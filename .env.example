// Variables de entorno del proyecto Biblioteca.
// Copiar a `.env` y rellenar los VALORES. `.env` está en .gitignore y nunca se commitea.
//
// REGLA (RD-10): este archivo documenta NOMBRES y PROPÓSITO. Los valores reales
// viven únicamente en tu máquina, en variables de entorno o en el secreto de usuario.

ConnectionStrings__Biblioteca=Server=localhost;Database=Biblioteca;Trusted_Connection=True;TrustServerCertificate=True

// Correo saliente (RF-NOT-13). Son credenciales: nunca se versionan.
Correo__Host=
Correo__Puerto=587
Correo__Usuario=
Correo__Contrasena=
Correo__UsarSsl=true
Correo__Remitente=