# Variables de entorno del proyecto Biblioteca.
#
# Copiar a `.env` y rellenar los VALORES. `.env` esta en .gitignore y nunca se
# versiona (RD-10).
#
# REGLA (RD-10): este archivo documenta NOMBRES y PROPOSITO. Los valores reales
# viven unicamente en tu maquina, en variables de entorno o en el secreto de usuario.

# Cadena de conexion a SQL Server. Sin ella la API no arranca.
# Autenticacion de Windows: no hay contrasena que escribir ni que versionar.
ConnectionStrings__Biblioteca=Server=localhost;Database=Biblioteca;Trusted_Connection=True;TrustServerCertificate=True

# Servidor SMTP de salida. VACIO = el registro de usuarios funciona igual,
# porque el correo solo se encola y no se envia (RF-NOT-08).
Correo__Host=

# Puerto del servidor SMTP. 587 es el estandar para envio con STARTTLS.
Correo__Puerto=587

# Usuario de autenticacion en el servidor SMTP.
Correo__Usuario=

# Contrasena o CONTRASENA DE APLICACION del correo. Nunca se versiona (RF-NOT-13).
Correo__Contrasena=

# Usar STARTTLS. Se recomienda true.
Correo__UsarSsl=true

# Direccion desde la que se envia. Sin ella el emisor avisa que falta y termina con codigo 1.
Correo__Remitente=